hosts = {{ mysql_host }}:{{ mysql_port | default(3306) }}
user = {{ mailbox_user }}
password = {{ mailbox_password }}
dbname = {{ mysql_database }}
# A domain is accepted as a virtual ALIAS domain if virtual_aliases has ANY alias for it
# (one central table, no per-VM config). Used to accept recipients on the base domain of a
# zone (e.g. noreply@mail.shop.example), which the public MX would otherwise reject with
# 554 5.7.1, since only VERP addresses are delivered locally there.
# %% = literal % for LIKE; '%s' = the key (domain) Postfix looks up.
query = SELECT 1 FROM virtual_aliases WHERE source LIKE CONCAT('%%@', '%s') AND '%s' NOT REGEXP '^rbm[0-9]+[.]' LIMIT 1
